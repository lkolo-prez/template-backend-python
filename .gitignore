# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
# Note: uv.lock IS committed (reproducible builds). Caches are not.
.uv/

# Test / coverage / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# SBOM / scan outputs
sbom*.json
sbom*.txt
*.sarif
trivy-results.*

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Editors / OS
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local scratch
*.log
tmp/
