{
  "name": "template-backend-python",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "0.13.9"
    },
    "ghcr.io/devcontainers-extra/features/go-task:1": {}
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "PYTHONUNBUFFERED": "1"
  },
  "postCreateCommand": "uv sync --frozen --all-groups && uv run pre-commit install --install-hooks",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "task.vscode-task",
        "github.vscode-github-actions",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/template-backend-python/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "app", "onAutoForward": "notify" }
  }
}
