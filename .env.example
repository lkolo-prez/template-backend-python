# Copy to .env for local development: cp .env.example .env
# All variables are prefixed APP_ and map to app.config.Settings.
# NEVER commit a real .env. Do not put production secrets here.

# Service identity
APP_SERVICE_NAME=template-backend-python
APP_ENVIRONMENT=local

# HTTP server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ROOT_PATH=

# Observability
APP_LOG_LEVEL=DEBUG
APP_LOG_JSON=false
APP_OTEL_ENABLED=false
# APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Behaviour
APP_REQUEST_TIMEOUT_SECONDS=10
# Comma-separated list; empty disables CORS.
APP_CORS_ALLOW_ORIGINS=
